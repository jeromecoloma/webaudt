{
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Write(.claude/settings.json)",
      "Edit(.claude/settings.json)",
      "Write(.claude/hooks/**)",
      "Edit(.claude/hooks/**)",
      "Write(~/.config/webaudt/**)",
      "Edit(~/.config/webaudt/**)",
      "Write(~/.ssh/**)",
      "Write(~/.claude/settings.json)",
      "Write(~/.claude/settings.local.json)",
      "Write(~/.claude/hooks/**)",
      "Write(~/Library/LaunchAgents/**)",
      "Write(~/bin/**)",
      "Write(~/.zshrc)",
      "Write(~/.zprofile)",
      "Write(~/.gitconfig)",
      "Edit(~/.ssh/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/Library/LaunchAgents/**)",
      "Edit(~/bin/**)",
      "Edit(~/.zshrc)",
      "Edit(~/.zprofile)",
      "Edit(~/.gitconfig)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardrails.py\""
          }
        ]
      }
    ]
  }
}
